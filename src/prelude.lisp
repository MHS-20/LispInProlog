;;; Everything here needs no interpreter support, so it is written in Lisp.

(define (not x) (if x nil t))
(define (cadr x) (car (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
(define (foldl f acc xs)
  (if (null? xs) acc (foldl f (f acc (car xs)) (cdr xs))))
(define (reverse xs) (foldl (lambda (acc x) (cons x acc)) nil xs))
(define (length xs) (foldl (lambda (n x) (+ n 1)) 0 xs))
(define (map f xs)
  (if (null? xs) nil (cons (f (car xs)) (map f (cdr xs)))))
(define (filter p xs)
  (if (null? xs)
      nil
      (if (p (car xs))
          (cons (car xs) (filter p (cdr xs)))
          (filter p (cdr xs)))))
(define (append2 xs ys)
  (if (null? xs) ys (cons (car xs) (append2 (cdr xs) ys))))
(define (append &rest xss)
  (if (null? xss) nil (append2 (car xss) (apply append (cdr xss)))))
(define (nth n xs)
  (if (= n 0) (car xs) (nth (- n 1) (cdr xs))))

(defmacro let (bindings &rest body)
  `((lambda ,(map car bindings) ,@body) ,@(map cadr bindings)))
(defmacro let* (bindings &rest body)
  (if (null? bindings)
      `(begin ,@body)
      `(let (,(car bindings)) (let* ,(cdr bindings) ,@body))))
(defmacro cond (&rest clauses)
  (if (null? clauses)
      nil
      `(if ,(car (car clauses))
           (begin ,@(cdr (car clauses)))
           (cond ,@(cdr clauses)))))
(defmacro and (&rest xs)
  (if (null? xs)
      t
      (if (null? (cdr xs))
          (car xs)
          `(if ,(car xs) (and ,@(cdr xs)) nil))))
(defmacro or (&rest xs)
  (if (null? xs)
      nil
      (let ((v (gensym)))
        `(let ((,v ,(car xs)))
           (if ,v ,v (or ,@(cdr xs)))))))
(defmacro when (c &rest body) `(if ,c (begin ,@body) nil))
(defmacro unless (c &rest body) `(if ,c nil (begin ,@body)))
